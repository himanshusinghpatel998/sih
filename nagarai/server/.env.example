NODE_ENV=development
PORT=5000
JWT_SECRET=nagarai-dev-secret-change-me

# Storage is SQLite (server/data/nagarai.sqlite) — created automatically,
# no install, no account, no network needed. No MONGO_URI required.

# Cloudinary (optional — image uploads are skipped if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Prediction engine: 'rule' (default, no dependencies) or 'xgboost-live'
# (calls the Python ml-service running the real trained models — falls back
# to 'rule' automatically per-bin if the service is unreachable)
ML_ENGINE=xgboost-live
ML_SERVICE_URL=http://localhost:8000
